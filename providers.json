    "browseRegex": "<td[^>]*>(?:<a href=\"[^\"]*\"[^>]*style=\"display:\\s*none\"[^>]*>.*?</a>\\s*|<a href\\s*=\\s*\"[^\"]*\"></a>\\s*)?<a href\\s*=\\s*\"(?<url>/vault/(?<id>\\d+))\"[^>]*>(?<title>[^<]+)</a>(?<extra>.*?)</td>(?:\\s*<td[^>]*>(?<regions>.*?)</td>\\s*<td[^>]*>(?<version>[^<]*)</td>\\s*<td[^>]*>(?<languages>[^<]*)</td>)?",
